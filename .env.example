# Database — Neon Postgres (pooled connection string)
DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require

# Payload — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media storage — Cloudflare R2 (S3-compatible), wired up in a later phase
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email — Resend, wired up in Phase 4
RESEND_API_KEY=

# Spam protection — Cloudflare Turnstile, wired up in Phase 4
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: first super-admin created by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
