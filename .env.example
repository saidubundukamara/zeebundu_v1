# Database — local Docker Postgres (docker compose up -d). In production: Neon pooled connection string
DATABASE_URI=postgres://zeebundu:zeebundu@localhost:5432/zeebundu

# Payload — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media storage — Cloudflare R2 (S3-compatible), wired up in a later phase
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 uses "auto"
S3_REGION=auto

# Email — Resend (enquiry notifications + auto-replies).
# Leave RESEND_API_KEY empty in dev: Payload then logs emails to the console instead of sending.
# The from address must be on a domain verified in Resend (DNS records for zeebundu.com).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@zeebundu.com
EMAIL_FROM_NAME=Zeebundu Group

# Spam protection — Cloudflare Turnstile on the enquiry form.
# Leave both empty in dev to skip the widget and the check (production logs a warning).
# Local testing with Cloudflare's test keys: site key 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA (always passes) or
# 2x0000000000000000000000000000000AA (always fails).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: first super-admin created by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Analytics — Plausible (cookieless). Leave blank to disable; nothing is loaded.
# The domain exactly as added in Plausible, e.g. zeebundu.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: script URL for a self-hosted Plausible (default https://plausible.io/js/script.js)
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Error monitoring — Sentry. Leave the DSNs blank to disable (no SDK is loaded or bundled).
# Server/edge DSN; falls back to NEXT_PUBLIC_SENTRY_DSN. Usually the same value.
SENTRY_DSN=
# Browser DSN (inlined at build time — set before building)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: source-map upload. Without SENTRY_AUTH_TOKEN, builds skip the upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Scheduled publishing: Vercel Cron calls /api/payload-jobs/run with this as a Bearer token
CRON_SECRET=
